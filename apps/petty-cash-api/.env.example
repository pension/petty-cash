PORT=4000
APP_NAME=petty-cash
APP_ENV=development
DATABASE_URL=mysql://root:root@localhost:3306/petty_cash
MPAO_ENTITY_ID=
FILE_STORAGE=local
FILE_STORAGE_PATH=var/receipts
# Set FILE_STORAGE=gcs once credentials are installed and existing local receipts are migrated.
STORAGE_PROJECT_ID=mpao-1327
STORAGE_KEY_FILE=secrets/stag-bucket.json
STORAGE_MEDIA_BUCKET=staging.mpao-1327.appspot.com
CLIENT_ID=
CLIENT_SECRET=
GRANT_TYPE=client_credentials
AUTH_ENDPOINT=http://bifrost.pension
REDIRECT_URL=http://localhost:3000/auth/callback
JWT_PUB=./secrets/jwtRS256.key.pub
JWT_LOGGING=production
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=4
REDIS_PASSWORD=
REDIS_PREFIX=

# Optional server-side receipt extraction; manual entry always remains available.
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-3.5-flash-lite
