# Server
PORT=4000

# Database
DATABASE_URL=mysql://root:root@localhost:3306/petty-cash

# SHORT_DOMAIN is baked into `shortUrl` at link-creation time (see
# links.service.ts). Locally it points at petty-cash-api itself (port 4000,
# where the redirect engine's GET /:code actually lives), not petty-cash-ui's
# port 3000 — petty-cash-ui is a pure SPA with no route that could catch
# arbitrary short codes without colliding with its own pages (/links,
# /qrcodes, etc). Pointing this at 3000 would make every generated link
# 404 instead of redirecting/tracking. In production SHORT_DOMAIN is its
# own separate domain (mpo.mv), so this collision only exists locally.
SHORT_DOMAIN=localhost:4000

# Auth (@pension/midgard) — reusing the shared local-dev bifrost client that
# payouts-api and pcs-api also use for server-to-server (client_credentials).
APP_NAME=petty-cash-api
APP_ENV=development
CLIENT_ID=hcs-client-4321
CLIENT_SECRET=hcs-client-1234
GRANT_TYPE=client_credentials
AUTH_ENDPOINT=http://bifrost.pension
REDIRECT_URL=http://localhost:3000/auth/callback
JWT_PUB=./secrets/jwtRS256.key.pub
JWT_LOGGING=verbose

# Redis (identity/permission cache for @pension/midgard) — must be the SAME
# REDIS_DB as bifrost's own (see bifrost/.env), not a per-app-isolated one:
# @pension/midgard reads the RS256 public key bifrost caches at the bare key
# `oauth:public_key` in that DB to verify tokens. REDIS_PREFIX MUST be left
# empty — @pension/midgard's ioredis client applies it (via ioredis's
# `keyPrefix`) to every key on that client, including that shared bare
# `oauth:public_key` key, so any non-empty value breaks token verification
# (it'd look up "<prefix>:oauth:public_key", which doesn't exist). Matches
# what payouts-api/pcs-api actually do — neither sets REDIS_PREFIX either.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=4
REDIS_PASSWORD=
REDIS_PREFIX=
