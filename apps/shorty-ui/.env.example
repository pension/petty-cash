# Backend API
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1/shorturl
# Must match petty-cash-api's own SHORT_DOMAIN (apps/petty-cash-api/.env) — locally
# that's petty-cash-api's own port, not mpo.mv (production) or petty-cash-ui's own
# port 3000 (petty-cash-ui has no route that could catch arbitrary short codes).
NUXT_PUBLIC_SHORT_DOMAIN=localhost:4000

# Auth (@pension/midgard-nuxt) — reusing the shared local-dev bifrost client
# that payouts-ui and pcs-ui also log in against. The redirect URL below is
# already allowlisted on this client (it's payouts-ui's own callback URL),
# so this works without any changes on bifrost's side as long as petty-cash-ui
# runs on the default port 3000.
AUTH_URL=http://bifrost.pension
CLIENT_ID=pcs-client
CLIENT_SECRET=pcs-client-1
REDIRECT_URL=http://localhost:3000/auth/callback
SCOPES=read:users
