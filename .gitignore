# terraform (iac/) — .terraform/ is a local provider/module cache
# regenerated by `terraform init` (large, machine-specific, not source);
# .terraform.lock.hcl and backend.hcl are NOT ignored — those are meant to
# be committed (reproducible provider versions, shared backend config).
iac/**/.terraform/
*.tfstate
*.tfstate.*
